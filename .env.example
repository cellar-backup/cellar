# =============================================================================
# Cellar — Environment Variables
#
# All variables have sensible defaults. Override only what you need.
# For Docker Compose: copy to .env in the project root.
# For Kubernetes/Docker run: pass as environment variables to the container.
# =============================================================================

# ── Application ───────────────────────────────────────────────────────────────

APP_NAME=Cellar
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8420

# Comma-separated domains for cookie-based auth (Sanctum stateful)
#SANCTUM_STATEFUL_DOMAINS=localhost:8420,localhost

# ── Database ─────────────────────────────────────────────────────────────────

DB_CONNECTION=sqlite
#DB_DATABASE=/app/data/cellar.sqlite

# ── Redis (required for queue, cache, WebSocket) ─────────────────────────────

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
#REDIS_PASSWORD=
#REDIS_DB=0

# ── Queue & Cache ────────────────────────────────────────────────────────────

QUEUE_CONNECTION=redis
CACHE_STORE=redis

# ── Broadcasting (Reverb WebSocket) ──────────────────────────────────────────

BROADCAST_CONNECTION=reverb
REVERB_APP_ID=cellar
REVERB_APP_KEY=cellar-key
REVERB_APP_SECRET=cellar-secret
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http

# ── Cellar ───────────────────────────────────────────────────────────────────

# Max concurrent backup/restore jobs
#CELLAR_MAX_PARALLEL_JOBS=2

# Initial admin (used on first boot by cellar:seed-defaults)
#CELLAR_ADMIN_NAME=admin
#CELLAR_ADMIN_EMAIL=admin@cellar.local
#CELLAR_ADMIN_PASSWORD=admin

# ── Docker Compose only ──────────────────────────────────────────────────────

#CELLAR_PORT=8420
