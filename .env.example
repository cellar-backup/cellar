# =============================================================================
# Cellar — Environment Variables
#
# All variables have sensible defaults. Override only what you need.
# For Docker: pass as environment variables (entrypoint applies them to .env)
# For local dev: copy this file to .env and edit.
# =============================================================================

# ── Application ───────────────────────────────────────────────────────────────

APP_NAME=Cellar
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8420

# Trusted proxies — set to '*' to trust all (Docker/K8s), or comma-separated IPs
TRUSTED_PROXIES=*

# Comma-separated domains for cookie-based auth (Sanctum stateful)
#SANCTUM_STATEFUL_DOMAINS=localhost:8420,localhost

# ── Database ─────────────────────────────────────────────────────────────────

DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite

# PostgreSQL (uncomment to use instead of SQLite)
#DB_CONNECTION=pgsql
#DB_HOST=127.0.0.1
#DB_PORT=5432
#DB_DATABASE=cellar
#DB_USERNAME=cellar
#DB_PASSWORD=secret

# ── Redis (required for queue, cache, WebSocket) ─────────────────────────────

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
#REDIS_PASSWORD=
#REDIS_DB=0

# ── Queue & Cache ────────────────────────────────────────────────────────────

QUEUE_CONNECTION=redis
CACHE_STORE=redis

# ── Broadcasting (Reverb WebSocket) ──────────────────────────────────────────

BROADCAST_CONNECTION=reverb
REVERB_APP_ID=cellar
REVERB_APP_KEY=cellar-key
REVERB_APP_SECRET=cellar-secret
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http

# Internal Reverb server (do not change unless custom networking)
#REVERB_SERVER_HOST=127.0.0.1
#REVERB_SERVER_PORT=8080
#REVERB_SCALING_ENABLED=true

# ── Cellar ───────────────────────────────────────────────────────────────────

# Max concurrent backup/restore jobs
#CELLAR_MAX_PARALLEL_JOBS=2

# Log directory (container path)
#CELLAR_LOG_DIR=/app/data/logs

# Backup engine paths (container paths)
#CELLAR_BORG_PATH=/usr/bin/borg
#CELLAR_RESTIC_PATH=/usr/bin/restic
#CELLAR_KUBECTL_PATH=/usr/local/bin/kubectl

# Initial admin (used on first boot by seeder)
#CELLAR_ADMIN_NAME=admin
#CELLAR_ADMIN_EMAIL=admin@cellar.local
#CELLAR_ADMIN_PASSWORD=changeme

# ── Docker Compose only ──────────────────────────────────────────────────────

#CELLAR_PORT=8420
