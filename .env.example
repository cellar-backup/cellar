# =============================================================================
# Cellar — Environment Variables
#
# All variables have sensible defaults. Override only what you need.
# For Docker Compose: copy to .env in the project root.
# For Kubernetes/Docker run: pass as environment variables to the container.
# =============================================================================

# ── Application ───────────────────────────────────────────────────────────────

# Public URL (used for CORS, Sanctum cookies, links in notifications)
#APP_URL=http://localhost:8420

# Comma-separated domains for cookie-based auth (Sanctum stateful)
#SANCTUM_STATEFUL_DOMAINS=localhost:8420,localhost

# ── Redis (required) ─────────────────────────────────────────────────────────

#REDIS_HOST=redis
#REDIS_PORT=6379
#REDIS_PASSWORD=
#REDIS_DB=0

# ── Backups ───────────────────────────────────────────────────────────────────

# Max concurrent backup/restore jobs (default: 2)
#CELLAR_MAX_PARALLEL_JOBS=2

# ── Initial Admin (only used on first boot by cellar:seed-defaults) ───────────

#CELLAR_ADMIN_NAME=admin
#CELLAR_ADMIN_EMAIL=admin@cellar.local
#CELLAR_ADMIN_PASSWORD=admin

# ── Docker Compose only ──────────────────────────────────────────────────────

# Port exposed on the host (default: 8420)
#CELLAR_PORT=8420

# Enable debug mode (default: false — never enable in production)
#CELLAR_DEBUG=false
