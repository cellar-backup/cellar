# =============================================================================
# Cellar — Production Environment
# Copy to .env and adjust values for your setup.
#
# All variables have sensible defaults. You only need to set the ones
# you want to override.
# =============================================================================

# ── General ──────────────────────────────────────────────────────────────────

# Port exposed on the host (default: 8420)
#CELLAR_PORT=8420

# Public URL (used for CORS, links, etc.)
#APP_URL=http://localhost:8420

# Comma-separated domains that can use cookie-based auth (Sanctum)
#SANCTUM_STATEFUL_DOMAINS=localhost:8420,localhost

# Set to true to enable debug mode (never in production)
#CELLAR_DEBUG=false

# ── PostgreSQL (optional) ───────────────────────────────────────────────────
# Only needed when using the PostgreSQL override:
#   docker compose -f docker-compose.yml -f docker/docker-compose.postgres.yml up -d

#CELLAR_DB_NAME=cellar
#CELLAR_DB_USER=cellar
#CELLAR_DB_PASSWORD=cellar
