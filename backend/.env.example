# =============================================================================
# Cellar — Environment Configuration
# Copy to .env and adjust values for your setup.
# =============================================================================

APP_NAME=Cellar
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8420

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# Database (SQLite by default — zero config)
DB_CONNECTION=sqlite
DB_DATABASE=/app/data/cellar.sqlite

# Session
SESSION_DRIVER=cookie
SESSION_LIFETIME=120

# Queue & Cache (Redis)
QUEUE_CONNECTION=redis
CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=null

# Sanctum (comma-separated stateful domains)
SANCTUM_STATEFUL_DOMAINS=localhost:8420,localhost

# Broadcasting (Laravel Reverb)
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=cellar
REVERB_APP_KEY=cellar-key
REVERB_APP_SECRET=cellar-secret
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
REVERB_SCALING_ENABLED=true

# Cellar — Backup engines
CELLAR_BORG_PATH=/usr/bin/borg
CELLAR_RESTIC_PATH=/usr/bin/restic
CELLAR_KUBECTL_PATH=/usr/local/bin/kubectl

# Cellar — Concurrency
CELLAR_MAX_PARALLEL_JOBS=2

# Cellar — Logging
CELLAR_LOG_DIR=/var/log/cellar

# Cellar — Default admin (used on first boot by cellar:seed-defaults)
CELLAR_ADMIN_NAME=admin
CELLAR_ADMIN_EMAIL=admin@cellar.local
CELLAR_ADMIN_PASSWORD=admin

# Cellar — Setup tokens (two distinct concepts, don't confuse them)
#
# CELLAR_SETUP_TOKEN (env var) — gates the /setup endpoint. Requests to
#   /setup must include this token to be accepted. Set a strong random value.
# CELLAR_SETUP_TOKEN=
#
# data/.setup_token (file) — read by cellar:seed-defaults on first boot to
#   set the initial admin password. If this file exists and contains a non-weak
#   value, it is used as the admin password instead of generating a random one.
#   This file is NOT an env var; place it at <project-root>/data/.setup_token.
