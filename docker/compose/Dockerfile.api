# =============================================================================
# Cellar API — Dockerfile
# PHP 8.5 + Laravel 12 + Horizon (Redis queue)
# =============================================================================

FROM php:8.5-cli AS base

# System dependencies: borg, restic, DB clients, supervisor, kubectl
RUN apt-get update && apt-get install -y --no-install-recommends \
    borgbackup \
    restic \
    postgresql-client \
    default-mysql-client \
    curl \
    unzip \
    git \
    supervisor \
    cron \
    libpq-dev \
    libzip-dev \
    libsqlite3-dev \
    && docker-php-ext-install pdo pdo_mysql pdo_pgsql pdo_sqlite zip pcntl bcmath \
    && pecl install redis && docker-php-ext-enable redis \
    && rm -rf /var/lib/apt/lists/*

# Install kubectl for Kubernetes Radar feature
ARG KUBECTL_VERSION=v1.35.3
RUN curl -fsSL "https://dl.k8s.io/release/${KUBECTL_VERSION}/bin/linux/$(dpkg --print-architecture)/kubectl" \
    -o /usr/local/bin/kubectl \
    && chmod +x /usr/local/bin/kubectl

# Composer
COPY --from=composer:latest /usr/bin/composer /usr/bin/composer

WORKDIR /app

# Install PHP dependencies (cached layer when lock unchanged)
COPY composer.json composer.lock ./
RUN composer install --no-dev --no-scripts --no-autoloader --prefer-dist

# Application code
COPY app/ app/
COPY bootstrap/ bootstrap/
COPY config/ config/
COPY database/ database/
COPY public/ public/
COPY resources/views/ resources/views/
COPY routes/ routes/
COPY storage/ storage/
COPY artisan .
COPY .env.example .

# Finish composer: autoloader + provider discovery
RUN composer install --no-dev --optimize-autoloader --prefer-dist

# Create data directories
RUN mkdir -p /app/data /data/repositories /var/log/cellar/jobs storage/framework/{cache,sessions,testing,views} \
    && chown -R www-data:www-data /app/data /data/repositories /var/log/cellar storage bootstrap/cache

# Entrypoint
COPY docker/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

EXPOSE 8000

ENTRYPOINT ["/entrypoint.sh"]

# Default: run the API server (php artisan serve)
CMD ["php", "artisan", "serve", "--host=0.0.0.0", "--port=8000"]
