# =============================================================================
# Cellar UI — Dockerfile
# Vue 3 + Vite — multi-stage build (standalone SPA for compose dev setup)
# =============================================================================

# ---- Build stage ----
FROM node:25-alpine AS build

WORKDIR /app

COPY package.json package-lock.json* ./
RUN if [ -f package-lock.json ]; then npm ci; else npm install; fi

COPY vite.config.ts tsconfig.json env.d.ts ./
COPY resources/ resources/
RUN npm run build

# ---- Production stage ----
FROM nginx:alpine

COPY docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/public/build /usr/share/nginx/html/build
COPY public/logo.svg /usr/share/nginx/html/logo.svg

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
