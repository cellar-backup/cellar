# =============================================================================
# Cellar .gitignore
# =============================================================================

# ----- PHP / Laravel -----
/backend/vendor/
/backend/.env
/backend/.env.backup
/backend/storage/*.key
/backend/storage/framework/cache/data/*
/backend/storage/framework/sessions/*
/backend/storage/framework/views/*
/backend/bootstrap/cache/*
*.log
*.sqlite
*.sqlite-journal

# ----- Node / Frontend -----
node_modules/
.npm
.pnpm-store/
*.tsbuildinfo
.vite/

# ----- Build outputs -----
frontend/dist/
docs/.vitepress/dist/
docs/.vitepress/cache/

# ----- Compiled TS/Vue duplicates -----
frontend/src/**/*.js
frontend/src/**/*.vue.js

# ----- Docker -----
docker-compose.override.yml

# ----- Environment -----
.env
.env.local
.env.*.local
!.env.example
!backend/.env.docker

# ----- AI tools -----
CLAUDE.md
AI.local.md

# ----- IDE / Editor -----
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ----- Testing -----
coverage/
*.lcov
.phpunit.result.cache

# ----- Cellar runtime -----
cellar-cache/
cellar-logs/
*.bak
