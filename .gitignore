# =============================================================================
# Cellar .gitignore
# =============================================================================

# ----- PHP / Laravel -----
/vendor/
/.env
/.env.backup
/storage/*.key
/storage/framework/cache/data/*
/storage/framework/sessions/*
/storage/framework/views/*
/bootstrap/cache/*
*.log
*.sqlite
*.sqlite-journal

# ----- Node / Frontend -----
node_modules/
.npm
.pnpm-store/
*.tsbuildinfo
.vite/

# ----- Build outputs -----
/public/build/
/public/hot
docs/.vitepress/dist/
docs/.vitepress/cache/

# ----- Docker -----
docker-compose.override.yml

# ----- Environment -----
.env
.env.local
.env.*.local
!.env.example

# ----- AI tools -----
CLAUDE.md
AI.local.md

# ----- IDE / Editor -----
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ----- Testing -----
coverage/
*.lcov
.phpunit.result.cache

# ----- Cellar runtime -----
cellar-cache/
cellar-logs/
*.bak
